# Copy this file to .env.local and fill in the values.
# Local Supabase: run `npx supabase start` and copy the "API URL" and "anon key" it prints.
# Hosted Supabase: Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here

# Web push notifications (optional: without these, the app works but sends none).
# Generate a key pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server-only Supabase secret key (Project Settings > API Keys). Never expose it.
SUPABASE_SECRET_KEY=
